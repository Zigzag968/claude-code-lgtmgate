{
  "ghProject": { "owner": "Zigzag968", "projectNumber": 1 },
  "repo": "Zigzag968/claude-code-lgtmgate",
  "baseBranch": "main",
  "branchPrefix": "feat/",
  "worktreeRoot": "../worktrees/lgtmgate",
  "commands": {
    "build": "echo 'no build step (agent/command/hook definitions + JS/shell templates, no compiled artifact)'",
    "test": "bash templates/test-canonical-guards.sh && node scripts/run-flow-suite.cjs",
    "format": "echo 'no formatter configured'"
  },
  "ciChecks": ["guards", "smoke-install"],
  "oneWayDoorKinds": ["status", "agent", "hook", "seam"],
  "engineRepo": true,
  "oneWayDoorPaths": [
    "hooks/**",
    "!hooks/test-*",
    "docs/critical-paths.md"
  ],
  "provision": {
    "extraLinks": []
  },
  "preflight": {
    "canonicalStringBan": [],
    "envSymlink": "ignore"
  },
  "regressionGuard": {
    "testGlob": "",
    "testFnPattern": "",
    "baselineCmd": ""
  }
}
