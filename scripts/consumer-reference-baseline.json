{
  "config": [
    "baseBranch",
    "branchOverride",
    "classifierOutage",
    "commands",
    "commentHygiene",
    "commitHygiene",
    "conventionsRule",
    "ghProject",
    "models",
    "oneWayDoorKinds",
    "oneWayDoorPaths",
    "planAudit",
    "provision",
    "regressionGuard",
    "repo",
    "specifics",
    "stack",
    "worktreeRoot"
  ],
  "assembler": [],
  "reasons": [],
  "hooks": [
    "Stop-supervise-runs.sh: Contamination detected",
    "SubagentStop-probe.sh: probe",
    "SubagentStop-worktree-cleanup.sh: WARNING",
    "block-merge-unchecked.sh: BLOCKED",
    "deny-destructive-git.sh: A bare recursive rm of a worktree (a direct child of the worktree root)",
    "deny-destructive-git.sh: gh api -X DELETE / --method DELETE on git/refs/heads/* (remote-branch deletion)",
    "deny-destructive-git.sh: git checkout -- <path> (discard)",
    "deny-destructive-git.sh: git clean",
    "deny-destructive-git.sh: git push --delete/-d (remote-ref deletion)",
    "deny-destructive-git.sh: git push --force (any form, including --force-with-lease/-f)",
    "deny-destructive-git.sh: git push <remote> :<ref> (colon-refspec delete)",
    "deny-destructive-git.sh: git reset --hard",
    "deny-destructive-git.sh: git worktree prune",
    "deny-destructive-git.sh: git worktree remove",
    "deny-destructive-git.sh: jq is required"
  ]
}
