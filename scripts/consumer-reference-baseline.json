{
  "config": [
    "baseBranch",
    "branchOverride",
    "classifierOutage",
    "commands",
    "commentHygiene",
    "commitHygiene",
    "conventionsRule",
    "ghProject",
    "models",
    "oneWayDoorKinds",
    "oneWayDoorPaths",
    "planAudit",
    "preflight",
    "provision",
    "regressionGuard",
    "repo",
    "specifics",
    "stack",
    "worktreeRoot"
  ],
  "assembler": [
    "at-line",
    "control-char",
    "frontmatter-duplicate-key",
    "frontmatter-empty-value",
    "frontmatter-forbidden-value",
    "frontmatter-hint-too-long",
    "frontmatter-lane-metadata-conflict",
    "frontmatter-lane-mismatch",
    "frontmatter-lane-name",
    "frontmatter-needs-lane",
    "frontmatter-on-context-file",
    "frontmatter-on-role-file",
    "frontmatter-paths",
    "frontmatter-paths-entry-too-long",
    "frontmatter-paths-too-many",
    "frontmatter-persona-duplicate",
    "frontmatter-persona-not-one-token",
    "frontmatter-persona-role-name",
    "frontmatter-persona-too-long",
    "frontmatter-second-delimiter",
    "frontmatter-syntax",
    "frontmatter-too-large",
    "frontmatter-unclosed",
    "frontmatter-unknown-key",
    "invalid-utf8",
    "invisible-char",
    "machine-literal",
    "machine-marker",
    "one-way-door-line",
    "too-many-files",
    "unclosed-comment"
  ],
  "reasons": [],
  "hooks": [
    "Stop-supervise-runs.sh: Contamination detected",
    "Stop-supervise-runs.sh: Pipeline run(s) in flight with no activity",
    "SubagentStop-probe.sh: probe",
    "SubagentStop-worktree-cleanup.sh: WARNING",
    "block-merge-unchecked.sh: BLOCKED",
    "deny-destructive-git.sh: A bare recursive rm of a worktree (a direct child of the worktree root)",
    "deny-destructive-git.sh: gh api -X DELETE / --method DELETE on git/refs/heads/* (remote-branch deletion)",
    "deny-destructive-git.sh: git checkout -- <path> (discard)",
    "deny-destructive-git.sh: git clean",
    "deny-destructive-git.sh: git push --delete/-d (remote-ref deletion)",
    "deny-destructive-git.sh: git push --force (any form, including --force-with-lease/-f)",
    "deny-destructive-git.sh: git push <remote> :<ref> (colon-refspec delete)",
    "deny-destructive-git.sh: git reset --hard",
    "deny-destructive-git.sh: git worktree prune",
    "deny-destructive-git.sh: git worktree remove",
    "deny-destructive-git.sh: jq is required"
  ]
}
