{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Workflow",
      "Agent",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node *)",
      "Bash(bash *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  }
}
